{
  "name": "@capture-workbench/source",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "12.8.2"
  },
  "scripts": {
    "dev": "corepack pnpm nx run capture-workbench-desktop:dev-product",
    "dev:deterministic": "corepack pnpm nx run capture-workbench-desktop:dev-deterministic",
    "build": "corepack pnpm nx run-many -t build",
    "test": "corepack pnpm nx run-many -t test",
    "dead-code:check": "node tools/dead-code-gate.ts",
    "dead-code:update": "node tools/dead-code-gate.ts --update",
    "architecture:update": "node tools/architecture-graph.ts --write",
    "architecture:check": "node tools/architecture-graph.ts --check",
    "architecture-exceptions:check": "node tools/architecture-exceptions-gate.ts",
    "architecture-exceptions:update": "node tools/architecture-exceptions-gate.ts --update",
    "lint": "corepack pnpm nx run-many -t lint",
    "verify": "corepack pnpm run verify:workspace && corepack pnpm run verify:package && corepack pnpm run verify:smoke",
    "verify:workspace": "corepack pnpm nx run-many -t lint,typecheck,test,build,production-bundle-check,cargo-fmt-check,cargo-check,cargo-test,package-qa-test --parallel=false",
    "verify:package": "corepack pnpm nx run capture-angular:clean-consumer-smoke",
    "verify:smoke": "corepack pnpm nx run capture-workbench-desktop:smoke-deterministic && corepack pnpm nx run capture-workbench-e2e:e2e",
    "acceptance:three-projects": "node tools/three-project-acceptance.ts",
    "acceptance:three-projects:recorded": "node tools/three-project-acceptance.ts --recorded",
    "acceptance:capture-workbench": "node tools/three-project-acceptance.ts --capture-workbench-only",
    "verify:release-version": "node tools/verify-release-version.ts",
    "sync:release-version": "node tools/release/sync-versions.ts",
    "verify:modular-reuse:local": "corepack pnpm nx run capture-runtime:check-contracts && corepack pnpm nx run capture-runtime-client:build && corepack pnpm nx run capture-runtime-client-python:build && corepack pnpm nx run capture-sidecar-launcher:cargo-publish-dry-run"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "22.0.7",
    "@angular/animations": "22.0.7",
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "22.0.7",
    "@angular/router": "22.0.7",
    "@spartan-ng/brain": "1.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.0.7",
    "@angular-devkit/schematics": "22.0.7",
    "@angular/build": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@angular/language-service": "22.0.7",
    "@nx/angular": "23.1.2",
    "@nx/devkit": "23.1.2",
    "@nx/eslint": "23.1.2",
    "@nx/eslint-plugin": "23.1.2",
    "@nx/js": "23.1.2",
    "@nx/playwright": "23.1.2",
    "@nx/web": "23.1.2",
    "@nx/workspace": "23.1.2",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "22.0.7",
    "@softarc/eslint-plugin-sheriff": "~0.20.0",
    "@softarc/sheriff-core": "~0.20.0",
    "@spartan-ng/cli": "1.6.3",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tauri-apps/cli": "2.11.2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "ajv": "8.20.0",
    "angular-eslint": "22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "knip": "^6.44.0",
    "ng-packagr": "22.0.1",
    "nx": "23.1.2",
    "postcss": "^8.4.5",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "7.3.6",
    "vitest": "^4.0.8"
  },
  "nx": {
    "includedScripts": []
  }
}
