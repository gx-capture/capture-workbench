{
  "name": "@capture-workbench/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm nx run capture-workbench-desktop:dev-deterministic",
    "dev:staged-runtime": "pnpm nx run capture-workbench-desktop:dev",
    "build": "pnpm nx run-many -t build",
    "test": "pnpm nx run-many -t test",
    "lint": "pnpm nx run-many -t lint",
    "verify": "pnpm run verify:workspace && pnpm run verify:package && pnpm run verify:smoke",
    "verify:workspace": "pnpm nx run-many -t lint,typecheck,test,build,production-bundle-check,cargo-fmt-check,cargo-check,cargo-test,package-qa-test --parallel=false",
    "verify:package": "pnpm nx run capture-angular:clean-consumer-smoke",
    "verify:smoke": "pnpm nx run capture-workbench-desktop:smoke-deterministic && pnpm nx run capture-workbench-e2e:e2e",
    "verify:release-version": "node tools/verify-release-version.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@tauri-apps/api": "2.11.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.7.5",
    "@nx/devkit": "22.7.5",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/playwright": "22.7.5",
    "@nx/web": "22.7.5",
    "@nx/workspace": "22.7.5",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~21.2.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tauri-apps/cli": "2.11.2",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^21.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "~21.2.0",
    "nx": "22.7.5",
    "postcss": "^8.4.5",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.3.2",
    "vitest": "^4.0.8"
  },
  "nx": {
    "includedScripts": []
  }
}
