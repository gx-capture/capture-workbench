{
  "name": "@capture-workbench/source",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "12.8.2"
  },
  "scripts": {
    "dev": "corepack pnpm nx run capture-workbench-desktop:dev-product",
    "dev:deterministic": "corepack pnpm nx run capture-workbench-desktop:dev-deterministic",
    "build": "corepack pnpm nx run-many -t build",
    "test": "corepack pnpm nx run-many -t test",
    "dead-code:check": "node tools/dead-code-gate.ts",
    "dead-code:update": "node tools/dead-code-gate.ts --update",
    "architecture:update": "node tools/architecture-graph.ts --write",
    "architecture:check": "node tools/architecture-graph.ts --check",
    "architecture-exceptions:check": "node tools/architecture-exceptions-gate.ts",
    "architecture-exceptions:update": "node tools/architecture-exceptions-gate.ts --update",
    "lint": "corepack pnpm nx run-many -t lint",
    "verify": "corepack pnpm run verify:workspace && corepack pnpm run verify:package && corepack pnpm run verify:smoke",
    "verify:workspace": "corepack pnpm nx run-many -t lint,typecheck,test,build,production-bundle-check,cargo-fmt-check,cargo-check,cargo-test,package-qa-test --parallel=false",
    "verify:affected": "corepack pnpm nx run capture-runtime:check-contracts && corepack pnpm nx run capture-angular:async-boundary-check && corepack pnpm nx affected -t classify-release-model-mode,python-version-check,typecheck,test,cargo-fmt-check,typecheck-scripts,package-qa-test,fake-runtime-routes,release-version-typecheck,python-candidate-index-typecheck,release-version-test,release-candidate-test,contract-impact-test,release-contract-test,consumer-gate-test,promotion-evidence-test,promotion-registry-test,release-manifest-test,release-index-test --base=origin/main && corepack pnpm nx affected -t lint --exclude=capture-tools,capture-workbench-desktop,capture-workbench-e2e --base=origin/main && corepack pnpm nx affected -t cargo-test --exclude=capture-workbench-desktop --base=origin/main",
    "verify:package": "corepack pnpm nx run capture-angular:clean-consumer-smoke",
    "verify:smoke": "corepack pnpm nx run capture-workbench-desktop:smoke-deterministic && corepack pnpm nx run capture-workbench-e2e:e2e",
    "acceptance:three-projects": "node tools/three-project-acceptance.ts",
    "acceptance:three-projects:recorded": "node tools/three-project-acceptance.ts --recorded",
    "acceptance:capture-workbench": "node tools/three-project-acceptance.ts --capture-workbench-only",
    "verify:release-version": "node tools/verify-release-version.ts",
    "sync:release-version": "node tools/release/sync-versions.ts",
    "verify:modular-reuse:local": "corepack pnpm nx run capture-runtime:check-contracts && corepack pnpm nx run capture-runtime-client:build && corepack pnpm nx run capture-runtime-client-python:build && corepack pnpm nx run capture-sidecar-launcher:cargo-publish-dry-run"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "22.2.5",
    "@angular/animations": "22.2.4",
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@spartan-ng/brain": "1.9.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "rxjs": "~7.8.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.5",
    "@angular-devkit/schematics": "22.2.5",
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@nx/angular": "24.0.3",
    "@nx/devkit": "24.0.3",
    "@nx/eslint": "24.0.3",
    "@nx/eslint-plugin": "24.0.3",
    "@nx/js": "24.0.3",
    "@nx/playwright": "24.0.3",
    "@nx/web": "24.0.3",
    "@nx/workspace": "24.0.3",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "22.2.5",
    "@softarc/eslint-plugin-sheriff": "~0.20.0",
    "@softarc/sheriff-core": "~0.20.0",
    "@spartan-ng/cli": "1.9.0",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.21",
    "@swc/helpers": "~0.5.23",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.19.2",
    "@typescript-eslint/utils": "^8.72.1",
    "angular-eslint": "22.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^1.8.3",
    "jsdom": "^27.4.0",
    "jsonc-eslint-parser": "^2.4.2",
    "knip": "^6.44.1",
    "ng-packagr": "22.2.5",
    "nx": "24.0.3",
    "postcss": "^8.5.32",
    "prettier": "~3.9.10",
    "tslib": "^2.9.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  },
  "nx": {
    "includedScripts": []
  }
}
