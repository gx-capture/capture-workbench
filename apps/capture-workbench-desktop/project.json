{
  "name": "capture-workbench-desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/capture-workbench-desktop/src-tauri/src",
  "tags": ["scope:capture", "type:desktop", "platform:windows"],
  "implicitDependencies": ["capture-workbench"],
  "targets": {
    "dev-product": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["stage-product-runtime"],
      "metadata": {
        "description": "Product desktop development with a verified release runtime and real providers."
      },
      "options": {
        "command": "corepack pnpm exec tauri dev --target x86_64-pc-windows-msvc --config apps/capture-workbench-desktop/src-tauri/tauri.conf.json"
      }
    },
    "dev-deterministic": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["stage-deterministic-runtime"],
      "metadata": {
        "description": "QA development host with fake runtime/data and required acceptance app-data isolation."
      },
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/build-deterministic-qa.ts --dev"
      }
    },
    "build": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["capture-workbench"],
          "target": "production-bundle-check"
        }
      ],
      "outputs": [
        "{projectRoot}/src-tauri/target/x86_64-pc-windows-msvc/release/capture-workbench-desktop.exe"
      ],
      "options": {
        "command": "corepack pnpm exec tauri build --target x86_64-pc-windows-msvc --no-bundle --ci --config apps/capture-workbench-desktop/src-tauri/tauri.conf.json"
      }
    },
    "build-nsis-deterministic": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["stage-deterministic-runtime"],
      "outputs": ["{projectRoot}/src-tauri/target/deterministic-qa/x86_64-pc-windows-msvc/release/bundle/nsis"],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/build-deterministic-qa.ts"
      },
      "metadata": {
        "description": "QA ONLY: separately named installer with fake runtime/data, acceptance-harness, isolated resources and Cargo output."
      }
    },
    "cargo-fmt": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --manifest-path apps/capture-workbench-desktop/src-tauri/Cargo.toml"
      }
    },
    "cargo-fmt-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "cargo fmt --manifest-path apps/capture-workbench-desktop/src-tauri/Cargo.toml -- --check"
      }
    },
    "cargo-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["stage-deterministic-runtime"],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/cargo-deterministic-qa.ts check"
      }
    },
    "cargo-test": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["stage-deterministic-runtime"],
      "inputs": [
        "default",
        "{workspaceRoot}/test-fixtures/ocr-evidence-v1-golden.json"
      ],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/cargo-deterministic-qa.ts test"
      }
    },
    "build-dev-host": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["stage-deterministic-runtime"],
      "outputs": [
        "{projectRoot}/src-tauri/target/debug/capture-workbench-dev-host.exe"
      ],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/cargo-deterministic-qa.ts build --features dev-host --bin capture-workbench-dev-host"
      }
    },
    "cargo-test-dev-host": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["stage-deterministic-runtime"],
      "inputs": [
        "default",
        "{workspaceRoot}/test-fixtures/ocr-evidence-v1-golden.json"
      ],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/cargo-deterministic-qa.ts test --features dev-host --lib --bin capture-workbench-dev-host"
      }
    },
    "cargo-check-product-refuses-dev-host": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["stage-deterministic-runtime"],
      "inputs": [
        "default",
        "{workspaceRoot}/test-fixtures/ocr-evidence-v1-golden.json"
      ],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/check-product-refuses-dev-host.ts"
      }
    },
    "contract-consistency": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "check-contracts",
          "projects": ["capture-runtime"]
        }
      ],
      "options": {
        "command": "node tools/check-desktop-contract-consistency.ts"
      }
    },
    "fake-runtime-routes": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/tools/check-fake-runtime-routes*.ts"
      ],
      "options": {
        "command": "node tools/check-fake-runtime-routes.ts"
      }
    },
    "stage-deterministic-runtime": {
      "cache": false,
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/src-tauri/target/deterministic-qa/staged/binaries/capture-runtime-x86_64-pc-windows-msvc.exe",
        "{projectRoot}/src-tauri/target/deterministic-qa/staged/resources/capture-runtime-manifest.json",
        "{projectRoot}/src-tauri/target/deterministic-qa/staged/resources/capture-document-v2.schema.json"
      ],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/stage-deterministic-runtime.ts"
      }
    },
    "stage-product-runtime": {
      "cache": false,
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/src-tauri/binaries/capture-runtime-x86_64-pc-windows-msvc.exe",
        "{projectRoot}/src-tauri/resources/capture-runtime-manifest.json",
        "{projectRoot}/src-tauri/resources/capture-document-v2.schema.json"
      ],
      "options": {
        "commands": [
          "corepack pnpm nx run capture-runtime:build-release-artifacts",
          "node apps/capture-workbench-desktop/scripts/stage-runtime.ts --artifact packages/capture-runtime/dist/release/capture-runtime-x86_64-pc-windows-msvc.exe --manifest packages/capture-runtime/dist/release/capture-runtime-manifest.json --schema packages/capture-runtime/dist/release/capture-document-v2.schema.json --source release"
        ],
        "parallel": false
      }
    },
    "stage-core-runtime": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build-core-release-artifacts",
          "projects": ["capture-runtime"]
        }
      ],
      "outputs": [
        "{projectRoot}/src-tauri/binaries/capture-runtime-x86_64-pc-windows-msvc.exe",
        "{projectRoot}/src-tauri/resources/capture-runtime-manifest.json",
        "{projectRoot}/src-tauri/resources/capture-document-v2.schema.json"
      ],
      "metadata": {
        "description": "Stages the measured core-only release set for NSIS boundary and size verification."
      },
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/stage-runtime.ts --artifact packages/capture-runtime/dist/core-release/capture-runtime-x86_64-pc-windows-msvc.exe --manifest packages/capture-runtime/dist/core-release/capture-runtime-manifest.json --schema packages/capture-runtime/dist/core-release/capture-document-v2.schema.json --source release"
      }
    },
    "build-nsis": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Packages only an already staged, verified release runtime."
      },
      "outputs": [
        "{projectRoot}/src-tauri/target/x86_64-pc-windows-msvc/release/bundle/nsis"
      ],
      "options": {
        "commands": [
          "node apps/capture-workbench-desktop/scripts/assert-staged-runtime.ts --release",
          "corepack pnpm exec tauri build --target x86_64-pc-windows-msvc --bundles nsis --ci --config apps/capture-workbench-desktop/src-tauri/tauri.conf.json"
        ],
        "parallel": false
      }
    },
    "build-nsis-acceptance": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Builds a separately named acceptance-only NSIS bundle with the compile-time acceptance-harness feature; never use as the release NSIS artifact."
      },
      "outputs": [
        "{workspaceRoot}/output/acceptance-nsis"
      ],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/build-acceptance-nsis.ts"
      }
    },
    "test-scripts": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "toolingCorpus",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/assets/worker-stage-policy-corpus.json"
      ],
      "options": {
        "command": "node --import ./tools/test-temp-root.ts --test apps/capture-workbench-desktop/scripts/*.test.ts tools/acceptance-contract.test.ts tools/worker-stage-policy.test.ts tools/three-project-acceptance.test.ts tools/three-project-cleanup-verifier.test.ts tools/check-async-boundary.test.ts tools/finalize-packed-package.test.ts tools/local-release-consumer-smoke.test.ts tools/node24-corepack.test.ts tools/record-candidate-verification.test.ts tools/acceptance-checkpoint-journal.test.ts tools/check-fake-runtime-routes.test.ts"
      }
    },
    "hash-qa-installer": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["build-nsis-deterministic"],
      "outputs": ["{workspaceRoot}/tmp/capture-workbench-desktop/hash-qa-installer"],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/hash-qa-installer.ts"
      }
    },
    "build-acceptance": {
      "cache": false,
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/src-tauri/target/x86_64-pc-windows-msvc/release/capture-workbench-desktop.exe"
      ],
      "options": {
        "command": "corepack pnpm exec tauri build --target x86_64-pc-windows-msvc --no-bundle --ci --features acceptance-harness --config apps/capture-workbench-desktop/src-tauri/tauri.conf.json"
      }
    },
    "typecheck-scripts": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/scripts/tsconfig.json",
        "{workspaceRoot}/tools/**/*.ts"
      ],
      "options": {
        "command": "corepack pnpm exec tsc -p apps/capture-workbench-desktop/tsconfig.json --noEmit"
      }
    },
    "smoke-deterministic": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["stage-deterministic-runtime"],
      "outputs": ["{workspaceRoot}/tmp/capture-workbench-desktop/smoke"],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/deterministic-smoke.ts"
      }
    },
    "smoke-real-ollama": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Opt-in Windows real-engine smoke. Requires a prepared isolated app-data directory and a user-provided PDF; excluded from ordinary CI."
      },
      "dependsOn": ["stage-product-runtime"],
      "outputs": [
        "{workspaceRoot}/tmp/capture-workbench-desktop/real-ollama-smoke/real-ollama-smoke.json"
      ],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/real-ollama-smoke.ts"
      }
    },
    "smoke-real-media": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Opt-in Windows staged-runtime PDF/image OCR and audio diagnostic. Requires an approved unused successor catalog plus user-provided media and app-data paths; it is not the Tauri/WebView release gate or consumer E2E."
      },
      "outputs": [
        "{workspaceRoot}/tmp/capture-workbench-desktop/real-media-smoke/real-media-smoke.json"
      ],
      "options": {
        "commands": [
          "node apps/capture-workbench-desktop/scripts/real-media-smoke.ts --preflight",
          "corepack pnpm nx run capture-workbench-desktop:stage-product-runtime",
          "node apps/capture-workbench-desktop/scripts/real-media-smoke.ts"
        ],
        "parallel": false
      }
    },
    "smoke-real-desktop-ocr": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Opt-in Windows standalone-app OCR smoke. Requires an explicitly prepared host app-data directory and a user-provided PDF; excluded from ordinary CI."
      },
      "outputs": [
        "{workspaceRoot}/tmp/capture-workbench-desktop/real-desktop-ocr-smoke/real-desktop-ocr-smoke.json"
      ],
      "options": {
        "commands": [
          "corepack pnpm nx run capture-workbench-desktop:stage-product-runtime",
          "corepack pnpm nx run capture-workbench-desktop:build",
          "node apps/capture-workbench-desktop/scripts/real-desktop-ocr-smoke.ts"
        ],
        "parallel": false
      }
    },
    "smoke-real-desktop-ocr-directml": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Opt-in local standalone-app OCR smoke that requires DirectML provenance (not a release gate). Requires an explicitly prepared host app-data directory and a user-provided scanned PDF."
      },
      "outputs": [
        "{workspaceRoot}/tmp/capture-workbench-desktop/real-desktop-ocr-smoke/real-desktop-ocr-smoke.json"
      ],
      "options": {
        "commands": [
          "corepack pnpm nx run capture-workbench-desktop:stage-product-runtime",
          "corepack pnpm nx run capture-workbench-desktop:build",
          "node apps/capture-workbench-desktop/scripts/real-desktop-ocr-smoke.ts --expected-ocr-device windowsml-dml"
        ],
        "parallel": false
      }
    },
    "diagnostic-desktop-ocr": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck-scripts"],
      "metadata": {
        "description": "Diagnostic only, not a release gate. Fail-closed Windows WebView2 OCR journey on the non-installed build-acceptance binary: first-run OCR setup, supplied document OCR, semantic result verification, diagnostics provenance, cleanup, and process/CDP proof."
      },
      "outputs": [
        "{workspaceRoot}/output/playwright/capture-workbench"
      ],
      "options": {
        "commands": [
          "corepack pnpm nx run capture-workbench-desktop:stage-product-runtime",
          "corepack pnpm nx run capture-workbench-desktop:build-acceptance",
          "node apps/capture-workbench-desktop/scripts/diagnostic-desktop-ocr.ts"
        ],
        "parallel": false
      }
    },
    "diagnostic-desktop-ocr-recorded": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck-scripts"],
      "metadata": {
        "description": "Diagnostic only, not a release gate. Recorded fail-closed Windows WebView2 OCR journey on the non-installed build-acceptance binary, with WebM, screenshots, hashes, and cleanup manifest."
      },
      "outputs": [
        "{workspaceRoot}/output/playwright/capture-workbench"
      ],
      "options": {
        "commands": [
          "corepack pnpm nx run capture-workbench-desktop:stage-product-runtime",
          "corepack pnpm nx run capture-workbench-desktop:build-acceptance",
          "node apps/capture-workbench-desktop/scripts/diagnostic-desktop-ocr.ts --recorded"
        ],
        "parallel": false
      }
    },
    "build-practical-installer": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Builds a side-by-side production NSIS installer (distinct identifier, product name and binary name only) from a verified runtime release directory. Pass --mode, --runtime-release, --runtime-sha256 and --run-id."
      },
      "outputs": ["{workspaceRoot}/tmp/capture-workbench-desktop/practical-installed"],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/build-practical-installer.ts"
      }
    },
    "acceptance-practical-installed": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "No-build practical OCR on an installed side-by-side production build: first-run setup, native import, durable OCR checkpoint, normal close, uninstall and cleanup proof. Pass --provenance, --input and --input-sha256 (plus --runtime-release for rehearsal)."
      },
      "outputs": ["{workspaceRoot}/tmp/capture-workbench-desktop/practical-installed"],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/practical-installed-ocr.ts"
      }
    },
    "acceptance-three-projects": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Sequentially runs Capture Workbench diagnostic desktop OCR, then the Cert Prep and LAW acceptance targets, and verifies each child manifest."
      },
      "outputs": ["{workspaceRoot}/output/playwright/three-projects"],
      "options": {
        "command": "node tools/three-project-acceptance.ts"
      }
    },
    "acceptance-three-projects-recorded": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Recorded sequential runner for Capture Workbench diagnostic desktop OCR and the Cert Prep and LAW acceptance targets."
      },
      "outputs": ["{workspaceRoot}/output/playwright/three-projects"],
      "options": {
        "command": "node tools/three-project-acceptance.ts --recorded"
      }
    },
    "smoke-installed-deterministic": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Explicit Windows-only installed smoke; performs a scoped silent install/uninstall and is intentionally excluded from ordinary verify and CI."
      },
      "dependsOn": ["build-nsis-deterministic"],
      "outputs": [
        "{workspaceRoot}/tmp/capture-workbench-desktop/installed-smoke/installed-smoke.json"
      ],
      "options": {
        "command": "node apps/capture-workbench-desktop/scripts/installed-nsis-smoke.ts"
      }
    },
    "measure-installed-core-size": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Performs a scoped release install/uninstall solely to record installed core-only NSIS bytes."
      },
      "outputs": [
        "{workspaceRoot}/tmp/capture-workbench-desktop/installed-smoke/installed-size.json"
      ],
      "options": {
        "commands": [
          "corepack pnpm nx run capture-workbench-desktop:stage-core-runtime",
          "corepack pnpm nx run capture-workbench-desktop:build-nsis",
          "node apps/capture-workbench-desktop/scripts/installed-nsis-smoke.ts --measure-release-size"
        ],
        "parallel": false
      }
    }
  }
}
