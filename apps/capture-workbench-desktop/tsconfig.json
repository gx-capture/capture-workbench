{
  "extends": "./scripts/tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "playwright.acceptance.config.ts",
    "scripts/**/*.ts",
    "../../tools/acceptance-contract.ts",
    "../../tools/acceptance-checkpoint-journal.test.ts",
    "../../tools/three-project-acceptance.ts",
    "../../tools/three-project-acceptance.test.ts"
  ],
  "exclude": ["node_modules", "tmp", "src-tauri/target", "scripts/fixtures/**/target/**"]
}
