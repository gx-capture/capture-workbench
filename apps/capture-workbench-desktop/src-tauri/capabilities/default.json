{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Capture Workbench desktop window is granted no plugin permission: the renderer calls only the application's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:deny-listen",
    "core:event:deny-unlisten",
    "core:event:deny-emit",
    "core:event:deny-emit-to",
    "dialog:deny-open",
    "dialog:deny-save",
    "dialog:deny-message",
    "dialog:deny-ask",
    "dialog:deny-confirm"
  ]
}
