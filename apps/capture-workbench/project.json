{
  "name": "capture-workbench",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/capture-workbench/src",
  "tags": ["scope:capture", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/capture-workbench",
        "browser": "apps/capture-workbench/src/main.ts",
        "tsConfig": "apps/capture-workbench/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/capture-workbench/public"
          }
        ],
        "styles": [
          "node_modules/@angular/material/prebuilt-themes/azure-blue.css",
          "apps/capture-workbench/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "optimization": {
            "styles": {
              "inlineCritical": false
            }
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "readyWhen": {
        "signal": true
      },
      "configurations": {
        "production": {
          "buildTarget": "capture-workbench:build:production"
        },
        "development": {
          "buildTarget": "capture-workbench:build:development"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "cache": true,
      "executor": "@nx/angular:unit-test",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/test-fixtures/ocr-evidence-v1-golden.json"
      ],
      "options": {
        "watch": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p apps/capture-workbench/tsconfig.app.json"
      }
    },
    "production-bundle-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/verify-capture-workbench-production-bundle.ts"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "capture-workbench:build",
        "port": 4200,
        "staticFilePath": "dist/apps/capture-workbench/browser",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    }
  }
}
