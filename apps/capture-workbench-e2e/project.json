{
  "name": "capture-workbench-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/capture-workbench-e2e/src",
  "tags": ["scope:capture", "type:e2e"],
  "implicitDependencies": ["capture-workbench"],
  "targets": {
    "typecheck": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tools/release/release-intent.ts"
      ],
      "options": {
        "command": "corepack pnpm exec tsc -p apps/capture-workbench-e2e/tsconfig.json --noEmit"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["capture-workbench"], "target": "build" }],
      "parallelism": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/release/release-intent.ts",
        "{workspaceRoot}/release/version.json"
      ],
      "options": {
        "command": "corepack pnpm exec playwright test --config apps/capture-workbench-e2e/playwright.config.ts"
      }
    },
    "e2e-dev-host": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Runs the dev-host Playwright E2E journey (dev-host.spec.ts) against the Workbench dev server and capture-workbench-dev-host with the deterministic fixture runtime."
      },
      "dependsOn": [
        { "projects": ["capture-workbench"], "target": "build" },
        { "projects": ["capture-workbench-desktop"], "target": "build-dev-host" }
      ],
      "parallelism": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/release/release-intent.ts",
        "{workspaceRoot}/release/version.json"
      ],
      "options": {
        "command": "corepack pnpm exec playwright test --config apps/capture-workbench-e2e/playwright.dev-host.config.ts"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "metadata": {
        "description": "Serves the Workbench dev server on http://localhost:4300 with the simulated desktop backend (preview-server.ts) for UI calibration and scenario review."
      },
      "dependsOn": [{ "projects": ["capture-workbench"], "target": "serve" }],
      "options": {
        "command": "node apps/capture-workbench-e2e/preview-server.ts 4300"
      }
    },
    "preview-dev-host": {
      "executor": "nx:run-commands",
      "continuous": true,
      "metadata": {
        "description": "Serves the Workbench dev server on http://127.0.0.1:4300 with capture-workbench-dev-host and the deterministic fixture runtime (dev-host-preview-server.ts) for interactive Layer 1 verification."
      },
      "dependsOn": [
        { "projects": ["capture-workbench"], "target": "serve" },
        { "projects": ["capture-workbench-desktop"], "target": "build-dev-host" }
      ],
      "options": {
        "command": "node apps/capture-workbench-e2e/dev-host-preview-server.ts 4300"
      }
    },
    "smoke-real-engines": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Manual opt-in Layer 1 real-engine smoke on localhost (real-engines.spec.ts) driving the Workbench UI against capture-workbench-dev-host and the staged product runtime with real OCR, TEA-ASR 1.1 mini + diarization, and Ollama structuring; excluded from ordinary CI."
      },
      "dependsOn": [
        { "projects": ["capture-workbench-desktop"], "target": "build-dev-host" },
        { "projects": ["capture-workbench-desktop"], "target": "stage-product-runtime" }
      ],
      "options": {
        "command": "corepack pnpm exec playwright test --config apps/capture-workbench-e2e/playwright.real-engines.config.ts"
      }
    },
    "runtime-web-component-e2e": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Manual Windows-only E2E journey for the packaged <capture-workbench> Web Component against the packaged Windows runtime; excluded from ordinary CI. Requires the packaged Windows runtime executable, uv with pypdfium2, and a scanned PDF from ../cert-prep/pdfs (or CAPTURE_WEB_COMPONENT_E2E_PDF). Run locally when verifying the packaged Web Component PDF OCR flow."
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/runtime-web-component-e2e.ts"
      ],
      "dependsOn": [
        {
          "target": "pack",
          "projects": ["capture-workbench-ui"]
        },
        {
          "target": "build-release-artifacts",
          "projects": ["capture-runtime"]
        }
      ],
      "options": {
        "command": "node tools/runtime-web-component-e2e.ts"
      }
    }
  }
}
