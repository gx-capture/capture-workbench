{
  "$defs": {
    "CaptureSourceKind": {
      "enum": [
        "pdf",
        "image",
        "audio"
      ],
      "title": "CaptureSourceKind",
      "type": "string"
    },
    "RuntimeCapabilitiesV1": {
      "additionalProperties": false,
      "properties": {
        "captureKinds": {
          "items": {
            "$ref": "#/$defs/CaptureSourceKind"
          },
          "title": "Capturekinds",
          "type": "array"
        },
        "structuringModes": {
          "items": {
            "$ref": "#/$defs/StructuringMode"
          },
          "title": "Structuringmodes",
          "type": "array"
        },
        "supportsCancellation": {
          "const": true,
          "default": true,
          "title": "Supportscancellation",
          "type": "boolean"
        },
        "supportsRawDiagnostics": {
          "const": true,
          "default": true,
          "title": "Supportsrawdiagnostics",
          "type": "boolean"
        },
        "maxUploadBytes": {
          "exclusiveMinimum": 0,
          "title": "Maxuploadbytes",
          "type": "integer"
        }
      },
      "required": [
        "captureKinds",
        "structuringModes",
        "maxUploadBytes"
      ],
      "title": "RuntimeCapabilitiesV1",
      "type": "object"
    },
    "StructuringMode": {
      "enum": [
        "runtime",
        "host"
      ],
      "title": "StructuringMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "service": {
      "const": "capture-runtime",
      "default": "capture-runtime",
      "title": "Service",
      "type": "string"
    },
    "apiVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Apiversion",
      "type": "string"
    },
    "runtimeVersion": {
      "const": "0.3.9",
      "default": "0.3.9",
      "title": "Runtimeversion",
      "type": "string"
    },
    "captureDocumentSchemaVersion": {
      "const": "1",
      "default": "1",
      "title": "Capturedocumentschemaversion",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/RuntimeCapabilitiesV1"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    }
  },
  "required": [
    "ready",
    "capabilities"
  ],
  "title": "RuntimeReadyV1",
  "type": "object"
}
