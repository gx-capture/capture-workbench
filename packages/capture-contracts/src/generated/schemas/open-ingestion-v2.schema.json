    },
    "clientRequestId": {
      "minLength": 1,
      "title": "Clientrequestid",
      "type": "string"
    },
    "fileName": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "mediaType": {
      "minLength": 1,
      "title": "Mediatype",
      "type": "string"
    },
    "totalBytes": {
      "exclusiveMinimum": 0,
      "title": "Totalbytes",
      "type": "integer"
    },
    "sourceSha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourcesha256"
    }
  },
  "required": [
    "clientRequestId",
    "fileName",
    "mediaType",
    "totalBytes"
