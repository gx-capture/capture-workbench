{
  "$defs": {
    "CaptureEngineV1": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "device": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        }
      },
      "required": [
        "engine",
        "model",
        "digest"
      ],
      "title": "CaptureEngineV1",
      "type": "object"
    },
    "CaptureSourceV1": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "fileName": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "mediaType": {
          "minLength": 1,
          "title": "Mediatype",
          "type": "string"
        },
        "bytes": {
          "minimum": 1,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "fileName",
        "mediaType",
        "bytes"
      ],
      "title": "CaptureSourceV1",
      "type": "object"
    },
    "PageLocatorV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "page",
          "default": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "boundingBox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundingbox"
        }
      },
      "required": [
        "page"
      ],
      "title": "PageLocatorV1",
      "type": "object"
    },
    "RawCaptureSegmentV1": {
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "minLength": 1,
          "title": "Segmentid",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "page": "#/$defs/PageLocatorV1",
              "time": "#/$defs/TimeLocatorV1"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocatorV1"
            },
            {
              "$ref": "#/$defs/TimeLocatorV1"
            }
          ],
          "title": "Locator"
        },
        "text": {
          "maxLength": 2000000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "order",
        "locator",
        "text"
      ],
      "title": "RawCaptureSegmentV1",
      "type": "object"
    },
    "TimeLocatorV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "time",
          "default": "time",
          "title": "Kind",
          "type": "string"
        },
        "startMs": {
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "endMs": {
          "exclusiveMinimum": 0,
          "title": "Endms",
          "type": "integer"
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "title": "TimeLocatorV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1",
      "default": "1",
      "title": "Schemaversion",
      "type": "string"
    },
    "diagnosticOnly": {
      "const": true,
      "default": true,
      "title": "Diagnosticonly",
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/CaptureSourceV1"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/RawCaptureSegmentV1"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "sourceText": {
      "maxLength": 8000000,
      "minLength": 1,
      "title": "Sourcetext",
      "type": "string"
    },
    "extractionEngine": {
      "$ref": "#/$defs/CaptureEngineV1"
    },
    "warnings": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Warnings",
      "type": "array"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    }
  },
  "required": [
    "source",
    "segments",
    "sourceText",
    "extractionEngine",
    "createdAt"
  ],
  "title": "RawCaptureV1",
  "type": "object"
}
