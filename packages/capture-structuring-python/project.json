{
  "name": "capture-structuring-python",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/capture-structuring-python/src",
  "projectType": "library",
  "tags": ["scope:capture", "type:sdk", "platform:python"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/capture-structuring-python",
        "command": "uv run --project . python -m pytest"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/capture-structuring-python",
        "command": "uv run --project . ruff check src tests && uv run --project . ruff format --check src tests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/capture-structuring-python",
        "command": "uv run --project . python -m mypy src"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "uv build --project packages/capture-structuring-python"
      }
    },
    "wheel-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "target": "build",
          "projects": ["capture-runtime-client-python"]
        }
      ],
      "options": {
        "command": "uv run tools/smoke-capture-structuring-wheel.py"
      }
    }
  }
}
