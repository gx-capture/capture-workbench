{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capture-workbench.dev/contracts/consumer-semantic-result-v1.schema.json",
  "title": "ConsumerSemanticResultV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "ConsumerSemanticResultV1" },
    "contractVersion": { "const": "1" },
    "contractSha256": { "$ref": "#/$defs/sha256" },
    "consumer": { "type": "string", "minLength": 1 },
    "parentGate": { "enum": ["D4", "D7"] },
    "tier": { "enum": ["candidate", "published"] },
    "sequenceIndex": { "type": "integer", "minimum": 1 },
    "childKey": { "type": "string", "minLength": 1 },
    "legId": { "type": "string", "minLength": 1 },
    "childId": { "$ref": "#/$defs/sha256" },
    "artifactIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sha256" },
      "uniqueItems": true
    },
    "fixtureResults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixtureResult" }
    },
    "semanticResultSha256": { "$ref": "#/$defs/sha256" }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "contractSha256",
    "consumer",
    "parentGate",
    "tier",
    "sequenceIndex",
    "childKey",
    "legId",
    "childId",
    "artifactIds",
    "fixtureResults",
    "semanticResultSha256"
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fixtureResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixtureIndex": { "type": "integer", "minimum": 0 },
        "fixtureKey": { "type": "string", "minLength": 1 },
        "fixtureIdentitySha256": { "$ref": "#/$defs/sha256" },
        "mediaKind": { "enum": ["jpeg", "pdf"] },
        "page": {
          "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
        },
        "mediaCapabilityHandleSha256": { "$ref": "#/$defs/sha256" },
        "oracleCapabilityHandleSha256": { "$ref": "#/$defs/sha256" },
        "mediaSha256": { "$ref": "#/$defs/sha256" },
        "oracleSha256": { "$ref": "#/$defs/sha256" },
        "actualNormalizedOutputSha256": { "$ref": "#/$defs/sha256" },
        "expectedNormalizedTruthSha256": { "$ref": "#/$defs/sha256" },
        "expectedAnchorSetSha256": { "$ref": "#/$defs/sha256" },
        "cer": { "type": "number", "minimum": 0 },
        "anchorOmissions": { "type": "integer", "minimum": 0 },
        "cerThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "outcome": { "enum": ["passed", "failed"] },
        "projectionSha256": { "$ref": "#/$defs/sha256" },
        "artifactId": { "$ref": "#/$defs/sha256" }
      },
      "required": [
        "fixtureIndex",
        "fixtureKey",
        "fixtureIdentitySha256",
        "mediaKind",
        "page",
        "mediaCapabilityHandleSha256",
        "oracleCapabilityHandleSha256",
        "mediaSha256",
        "oracleSha256",
        "actualNormalizedOutputSha256",
        "expectedNormalizedTruthSha256",
        "expectedAnchorSetSha256",
        "cer",
        "anchorOmissions",
        "cerThreshold",
        "outcome",
        "projectionSha256",
        "artifactId"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "mediaKind": { "const": "jpeg" } },
            "required": ["mediaKind"]
          },
          "then": { "properties": { "cerThreshold": { "const": 0.03 } } }
        },
        {
          "if": {
            "properties": { "mediaKind": { "const": "pdf" } },
            "required": ["mediaKind"]
          },
          "then": { "properties": { "cerThreshold": { "const": 0.01 } } }
        },
        {
          "if": {
            "properties": {
              "mediaKind": { "const": "jpeg" },
              "outcome": { "const": "passed" }
            },
            "required": ["mediaKind", "outcome"]
          },
          "then": {
            "properties": {
              "cer": { "type": "number", "maximum": 0.03 },
              "anchorOmissions": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mediaKind": { "const": "pdf" },
              "outcome": { "const": "passed" }
            },
            "required": ["mediaKind", "outcome"]
          },
          "then": {
            "properties": {
              "cer": { "type": "number", "maximum": 0.01 },
              "anchorOmissions": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mediaKind": { "const": "jpeg" },
              "outcome": { "const": "failed" }
            },
            "required": ["mediaKind", "outcome"]
          },
          "then": {
            "anyOf": [
              { "properties": { "cer": { "type": "number", "exclusiveMinimum": 0.03 } } },
              { "properties": { "anchorOmissions": { "type": "integer", "minimum": 1 } } }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mediaKind": { "const": "pdf" },
              "outcome": { "const": "failed" }
            },
            "required": ["mediaKind", "outcome"]
          },
          "then": {
            "anyOf": [
              { "properties": { "cer": { "type": "number", "exclusiveMinimum": 0.01 } } },
              { "properties": { "anchorOmissions": { "type": "integer", "minimum": 1 } } }
            ]
          }
        }
      ]
    }
  }
}
