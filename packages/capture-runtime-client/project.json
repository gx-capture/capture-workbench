{
  "name": "capture-runtime-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/capture-runtime-client/src",
  "projectType": "library",
  "tags": ["npm:public", "scope:capture", "type:sdk"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec tsc --noEmit -p packages/capture-runtime-client/tsconfig.json",
          "pnpm exec tsc --noEmit -p packages/capture-runtime-client/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "main": "packages/capture-runtime-client/src/index.ts",
        "outputPath": "dist/packages/capture-runtime-client",
        "outputFileName": "index.js",
        "rootDir": "packages/capture-runtime-client/src",
        "tsConfig": "packages/capture-runtime-client/tsconfig.lib.json",
        "generatePackageJson": true,
        "generateExportsField": true,
        "assets": [
          { "glob": "README.md", "input": "packages/capture-runtime-client", "output": "." },
          { "glob": "assets/**", "input": "packages/capture-runtime-client/src/private", "output": "private" }
        ]
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/packs"],
      "options": {
        "cwd": "dist/packages/capture-runtime-client",
        "command": "corepack pnpm pack --pack-destination ../../packs"
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/assets/contract-set.json",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/assets/contract-set.sha256",
        "{workspaceRoot}/packages/capture-runtime/tests/fixtures/ocr-projection-v3-perspective.json",
        "{workspaceRoot}/packages/capture-runtime/tests/fixtures/ocr-page-selection-v3.json",
        "{workspaceRoot}/packages/capture-runtime/tests/fixtures/ocr-projection-v3-referenced-invalid-corpus.json",
        "{workspaceRoot}/packages/capture-runtime/tests/fixtures/speaker-wire-samples.json"
      ],
      "options": {
        "command": "pnpm exec vitest run --config packages/capture-runtime-client/vitest.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/capture-runtime-client/src"
      }
    }
  }
}
