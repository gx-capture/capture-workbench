        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "schemaDialect": {
          "minLength": 1,
          "title": "Schemadialect",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "capability",
        "schemaDialect"
      ],
      "title": "StructuringProviderCapabilityV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
