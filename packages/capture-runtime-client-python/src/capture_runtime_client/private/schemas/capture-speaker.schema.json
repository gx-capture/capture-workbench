{
  "$defs": {
    "TimeLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "time",
          "default": "time",
          "title": "Kind",
          "type": "string"
        },
        "startMs": {
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "endMs": {
          "exclusiveMinimum": 0,
          "title": "Endms",
          "type": "integer"
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "title": "TimeLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An anonymous speaker and a stretch of the source to listen to and name them.",
  "properties": {
    "speakerId": {
      "pattern": "^[A-Za-z0-9_]{1,32}$",
      "title": "Speakerid",
      "type": "string"
    },
    "sample": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeLocator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "displayName": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Displayname"
    }
  },
  "required": [
    "speakerId"
  ],
  "title": "CaptureSpeaker",
  "type": "object"
}
