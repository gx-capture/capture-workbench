{
  "$defs": {
    "CaptureEngine": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "device": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        }
      },
      "required": [
        "engine",
        "model",
        "digest"
      ],
      "title": "CaptureEngine",
      "type": "object"
    },
    "CaptureSource": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "fileName": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "mediaType": {
          "minLength": 1,
          "title": "Mediatype",
          "type": "string"
        },
        "bytes": {
          "minimum": 1,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "fileName",
        "mediaType",
        "bytes"
      ],
      "title": "CaptureSource",
      "type": "object"
    },
    "PageLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "page",
          "default": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "boundingBox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundingbox"
        }
      },
      "required": [
        "page"
      ],
      "title": "PageLocator",
      "type": "object"
    },
    "RawCaptureSegment": {
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "minLength": 1,
          "title": "Segmentid",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "page": "#/$defs/PageLocator",
              "time": "#/$defs/TimeLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocator"
            },
            {
              "$ref": "#/$defs/TimeLocator"
            }
          ],
          "title": "Locator"
        },
        "text": {
          "maxLength": 2000000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "order",
        "locator",
        "text"
      ],
      "title": "RawCaptureSegment",
      "type": "object"
    },
    "TimeLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "time",
          "default": "time",
          "title": "Kind",
          "type": "string"
        },
        "startMs": {
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "endMs": {
          "exclusiveMinimum": 0,
          "title": "Endms",
          "type": "integer"
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "title": "TimeLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "2",
      "default": "2",
      "title": "Protocolversion",
      "type": "string"
    },
    "captureId": {
      "minLength": 1,
      "title": "Captureid",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/CaptureSource"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "coveredUntilMs": {
      "minimum": 0,
      "title": "Covereduntilms",
      "type": "integer"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/RawCaptureSegment"
      },
      "maxItems": 10000,
      "title": "Segments",
      "type": "array"
    },
    "sourceText": {
      "default": "",
      "maxLength": 8000000,
      "title": "Sourcetext",
      "type": "string"
    },
    "extractionEngine": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaptureEngine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "updatedAt": {
      "format": "date-time",
      "title": "Updatedat",
      "type": "string"
    }
  },
  "required": [
    "captureId",
    "source",
    "revision",
    "coveredUntilMs",
    "updatedAt"
  ],
  "title": "PartialCaptureV2",
  "type": "object"
}
