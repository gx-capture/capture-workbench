{
  "$defs": {
    "OcrProvenanceUnavailableReason": {
      "enum": [
        "model_unavailable",
        "worker_crashed",
        "worker_timeout",
        "protocol_failure"
      ],
      "title": "OcrProvenanceUnavailableReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Profile identity retained when model identity is not yet available.",
  "properties": {
