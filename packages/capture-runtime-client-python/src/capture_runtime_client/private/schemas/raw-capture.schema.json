{
  "$defs": {
    "CaptureEngine": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "device": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        }
      },
      "required": [
        "engine",
        "model",
        "digest"
      ],
      "title": "CaptureEngine",
      "type": "object"
    },
    "CaptureSource": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "fileName": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "mediaType": {
          "minLength": 1,
          "title": "Mediatype",
          "type": "string"
        },
        "bytes": {
          "minimum": 1,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "fileName",
        "mediaType",
        "bytes"
      ],
      "title": "CaptureSource",
      "type": "object"
    },
    "CaptureSpeaker": {
      "additionalProperties": false,
      "description": "An anonymous speaker and a stretch of the source to listen to and name them.",
      "properties": {
        "speakerId": {
          "pattern": "^[A-Za-z0-9_]{1,32}$",
          "title": "Speakerid",
          "type": "string"
        },
        "sample": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "displayName": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        }
      },
      "required": [
        "speakerId"
      ],
      "title": "CaptureSpeaker",
      "type": "object"
    },
    "OcrPageScopeV2": {
      "additionalProperties": false,
      "description": "Public evidence describing which PDF pages entered OCR.\n\nPage numbers are the source PDF's, in ascending order. A selection may\nleave pages out, so the source can have more pages than were read.",
      "properties": {
        "sourcePageCount": {
          "minimum": 1,
          "title": "Sourcepagecount",
          "type": "integer"
        },
        "requestedPageNumbers": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Requestedpagenumbers",
          "type": "array"
        },
        "processedPageNumbers": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Processedpagenumbers",
          "type": "array"
        }
      },
      "required": [
        "sourcePageCount",
        "requestedPageNumbers",
        "processedPageNumbers"
      ],
      "title": "OcrPageScopeV2",
      "type": "object"
    },
    "PageLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "page",
          "default": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "boundingBox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundingbox"
        }
      },
      "required": [
        "page"
      ],
      "title": "PageLocator",
      "type": "object"
    },
    "RawCaptureSegment": {
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "minLength": 1,
          "title": "Segmentid",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "page": "#/$defs/PageLocator",
              "time": "#/$defs/TimeLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocator"
            },
            {
              "$ref": "#/$defs/TimeLocator"
            }
          ],
          "title": "Locator"
        },
        "text": {
          "maxLength": 2000000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "speakerOverlap": {
          "default": false,
          "title": "Speakeroverlap",
          "type": "boolean"
        }
      },
      "required": [
        "segmentId",
        "order",
        "locator",
        "text"
      ],
      "title": "RawCaptureSegment",
      "type": "object"
    },
    "TimeLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "time",
          "default": "time",
          "title": "Kind",
          "type": "string"
        },
        "startMs": {
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "endMs": {
          "exclusiveMinimum": 0,
          "title": "Endms",
          "type": "integer"
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "title": "TimeLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2",
      "default": "2",
      "title": "Schemaversion",
      "type": "string"
    },
    "diagnosticOnly": {
      "const": true,
      "default": true,
      "title": "Diagnosticonly",
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/CaptureSource"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/RawCaptureSegment"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "sourceText": {
      "maxLength": 8000000,
      "minLength": 1,
      "title": "Sourcetext",
      "type": "string"
    },
    "extractionEngine": {
      "$ref": "#/$defs/CaptureEngine"
    },
    "diarizationEngine": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaptureEngine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "speakers": {
      "items": {
        "$ref": "#/$defs/CaptureSpeaker"
      },
      "maxItems": 64,
      "title": "Speakers",
      "type": "array"
    },
    "suggestedUnits": {
      "items": {
        "enum": [
          "windowsml-ocr",
          "whisper-primary",
          "speaker-diarization",
          "vertical-japanese-reader",
          "ollama-runtime",
          "capture-ollama-model"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "title": "Suggestedunits",
      "type": "array"
    },
    "warnings": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Warnings",
      "type": "array"
    },
    "ocrPageScope": {
      "anyOf": [
        {
          "$ref": "#/$defs/OcrPageScopeV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    }
  },
  "required": [
    "source",
    "segments",
    "sourceText",
    "extractionEngine",
    "createdAt"
  ],
  "title": "RawCapture",
  "type": "object"
}
