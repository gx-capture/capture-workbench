{
  "$defs": {
    "StructuringMode": {
      "enum": [
        "runtime",
        "host"
      ],
      "title": "StructuringMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "2",
      "default": "2",
      "title": "Protocolversion",
      "type": "string"
    },
    "clientRequestId": {
      "minLength": 1,
      "title": "Clientrequestid",
      "type": "string"
    },
    "ingestionId": {
      "minLength": 1,
      "title": "Ingestionid",
      "type": "string"
    },
    "structuringMode": {
      "$ref": "#/$defs/StructuringMode"
    },
    "targetLanguage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Targetlanguage"
    },
    "startPolicy": {
      "const": "eager",
      "default": "eager",
      "title": "Startpolicy",
      "type": "string"
    },
    "pdfPageNumbers": {
      "anyOf": [
        {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 500,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "PDF only: the source pages to read, one-based, ascending and without duplicates, for example [3, 7, 8, 20]. OCR results keep these page numbers. Omit it to read every page.",
      "title": "Pdfpagenumbers"
    },
    "identifySpeakers": {
      "default": false,
      "title": "Identifyspeakers",
      "type": "boolean"
    }
  },
  "required": [
    "clientRequestId",
    "ingestionId",
    "structuringMode"
  ],
  "title": "StartCaptureV2",
  "type": "object"
}
