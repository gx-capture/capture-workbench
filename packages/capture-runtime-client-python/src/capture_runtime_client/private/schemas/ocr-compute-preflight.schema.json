{
  "$defs": {
    "OcrAdapterClass": {
      "enum": [
        "dedicated",
        "integrated",
        "unknown"
      ],
      "title": "OcrAdapterClass",
      "type": "string"
    },
    "OcrComputeMode": {
      "enum": [
        "gpu",
        "cpu-fallback"
      ],
      "title": "OcrComputeMode",
      "type": "string"
    },
    "OcrComputeNoticeCode": {
      "enum": [
        "ocr_cpu_fallback"
      ],
      "title": "OcrComputeNoticeCode",
      "type": "string"
    },
    "OcrComputeReasonCode": {
      "enum": [
        "no_compatible_gpu",
        "gpu_provider_unavailable"
      ],
      "title": "OcrComputeReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Runtime-owned pre-OCR compute selection and user-notice contract.",
  "properties": {
    "apiVersion": {
      "const": "2.0",
      "default": "2.0",
      "title": "Apiversion",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1",
      "default": "1",
      "title": "Schemaversion",
      "type": "string"
    },
    "service": {
      "const": "capture-runtime",
      "default": "capture-runtime",
      "title": "Service",
      "type": "string"
    },
    "runtimeVersion": {
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Runtimeversion",
      "type": "string"
    },
    "contractSetVersion": {
      "const": "2",
      "default": "2",
      "title": "Contractsetversion",
      "type": "string"
    },
    "contractSetSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contractsetsha256",
      "type": "string"
    },
    "workerSha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workersha256"
    },
    "mode": {
      "$ref": "#/$defs/OcrComputeMode"
    },
    "adapterClass": {
      "$ref": "#/$defs/OcrAdapterClass"
    },
    "reasonCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/OcrComputeReasonCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "userNoticeRequired": {
      "title": "Usernoticerequired",
      "type": "boolean"
    },
    "noticeCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/OcrComputeNoticeCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "contractSetSha256",
    "mode",
    "adapterClass",
    "userNoticeRequired",
    "runtimeVersion"
  ],
  "title": "OcrComputePreflight",
  "type": "object"
}
