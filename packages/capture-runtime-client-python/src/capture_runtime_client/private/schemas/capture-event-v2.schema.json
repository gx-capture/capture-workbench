{
  "$defs": {
    "CaptureFailureV2": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CaptureFailureV2",
      "type": "object"
    },
    "CaptureSourceKind": {
      "enum": [
        "pdf",
        "image",
        "audio"
      ],
      "title": "CaptureSourceKind",
      "type": "string"
    },
    "PageLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "page",
          "default": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "boundingBox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundingbox"
        }
      },
      "required": [
        "page"
      ],
      "title": "PageLocator",
      "type": "object"
    },
    "RawCaptureSegment": {
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "minLength": 1,
          "title": "Segmentid",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "page": "#/$defs/PageLocator",
              "time": "#/$defs/TimeLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocator"
            },
            {
              "$ref": "#/$defs/TimeLocator"
            }
          ],
          "title": "Locator"
        },
        "text": {
          "maxLength": 2000000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "order",
        "locator",
        "text"
      ],
      "title": "RawCaptureSegment",
      "type": "object"
    },
    "StreamingEventType": {
      "enum": [
        "accepted",
        "input_checkpoint",
        "heartbeat",
        "segment",
        "checkpoint",
        "resync_required",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "StreamingEventType",
      "type": "string"
    },
    "TimeLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "time",
          "default": "time",
          "title": "Kind",
          "type": "string"
        },
        "startMs": {
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "endMs": {
          "exclusiveMinimum": 0,
          "title": "Endms",
          "type": "integer"
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "title": "TimeLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "2",
      "default": "2",
      "title": "Protocolversion",
      "type": "string"
    },
    "eventId": {
      "minLength": 1,
      "title": "Eventid",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "captureId": {
      "minLength": 1,
      "title": "Captureid",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CaptureSourceKind",
      "default": "audio"
    },
    "eventType": {
      "$ref": "#/$defs/StreamingEventType"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "progress": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress"
    },
    "partialRevision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Partialrevision"
    },
    "coveredUntilMs": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Covereduntilms"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/RawCaptureSegment"
      },
      "maxItems": 1000,
      "title": "Segments",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaptureFailureV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    }
  },
  "required": [
    "eventId",
    "sequence",
    "captureId",
    "eventType",
    "stage",
    "createdAt"
  ],
  "title": "CaptureEventV2",
  "type": "object"
}
