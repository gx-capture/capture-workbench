{
  "$defs": {
    "CaptureSourceKind": {
      "enum": [
        "pdf",
        "image",
        "recording"
      ],
      "title": "CaptureSourceKind",
      "type": "string"
    },
    "OcrAdapterClass": {
      "enum": [
        "dedicated",
        "integrated",
        "unknown"
      ],
      "title": "OcrAdapterClass",
      "type": "string"
    },
    "OcrComputeMode": {
      "enum": [
        "gpu",
        "cpu-fallback"
      ],
      "title": "OcrComputeMode",
      "type": "string"
    },
    "OcrComputeNoticeCode": {
      "enum": [
        "ocr_cpu_fallback"
      ],
      "title": "OcrComputeNoticeCode",
      "type": "string"
    },
    "OcrComputePreflight": {
      "additionalProperties": false,
      "description": "Runtime-owned pre-OCR compute selection and user-notice contract.",
      "properties": {
        "apiVersion": {
          "const": "2.0",
          "default": "2.0",
          "title": "Apiversion",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1",
          "default": "1",
          "title": "Schemaversion",
          "type": "string"
        },
        "service": {
          "const": "capture-runtime",
          "default": "capture-runtime",
          "title": "Service",
          "type": "string"
        },
        "runtimeVersion": {
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Runtimeversion",
          "type": "string"
        },
        "contractSetVersion": {
          "const": "2",
          "default": "2",
          "title": "Contractsetversion",
          "type": "string"
        },
        "contractSetSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contractsetsha256",
          "type": "string"
        },
        "workerSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workersha256"
        },
        "mode": {
          "$ref": "#/$defs/OcrComputeMode"
        },
        "adapterClass": {
          "$ref": "#/$defs/OcrAdapterClass"
        },
        "reasonCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/OcrComputeReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "userNoticeRequired": {
          "title": "Usernoticerequired",
          "type": "boolean"
        },
        "noticeCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/OcrComputeNoticeCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "contractSetSha256",
        "mode",
        "adapterClass",
        "userNoticeRequired",
        "runtimeVersion"
      ],
      "title": "OcrComputePreflight",
      "type": "object"
    },
    "OcrComputeReasonCode": {
      "enum": [
        "no_compatible_gpu",
        "gpu_provider_unavailable"
      ],
      "title": "OcrComputeReasonCode",
      "type": "string"
    },
    "RuntimeCapabilities": {
      "additionalProperties": false,
      "description": "What this runtime accepts: capture kinds, structuring modes and upload limits.",
      "properties": {
        "captureKinds": {
          "items": {
            "$ref": "#/$defs/CaptureSourceKind"
          },
          "minItems": 1,
          "title": "Capturekinds",
          "type": "array"
        },
        "structuringModes": {
          "items": {
            "$ref": "#/$defs/StructuringMode"
          },
          "minItems": 1,
          "title": "Structuringmodes",
          "type": "array"
        },
        "supportsCancellation": {
          "title": "Supportscancellation",
          "type": "boolean"
        },
        "supportsRawDiagnostics": {
          "title": "Supportsrawdiagnostics",
          "type": "boolean"
        },
        "maxUploadBytes": {
          "exclusiveMinimum": 0,
          "title": "Maxuploadbytes",
          "type": "integer"
        },
        "maxChunkBytes": {
          "exclusiveMinimum": 0,
          "maximum": 4194304,
          "title": "Maxchunkbytes",
          "type": "integer"
        },
        "checkpointIntervalMs": {
          "exclusiveMinimum": 0,
          "title": "Checkpointintervalms",
          "type": "integer"
        },
        "heartbeatIntervalMs": {
          "exclusiveMinimum": 0,
          "title": "Heartbeatintervalms",
          "type": "integer"
        },
        "stallTimeoutMs": {
          "exclusiveMinimum": 0,
          "title": "Stalltimeoutms",
          "type": "integer"
        },
        "supportsProgressiveRecording": {
          "title": "Supportsprogressiverecording",
          "type": "boolean"
        }
      },
      "required": [
        "captureKinds",
        "structuringModes",
        "supportsCancellation",
        "supportsRawDiagnostics",
        "maxUploadBytes",
        "maxChunkBytes",
        "checkpointIntervalMs",
        "heartbeatIntervalMs",
        "stallTimeoutMs",
        "supportsProgressiveRecording"
      ],
      "title": "RuntimeCapabilities",
      "type": "object"
    },
    "StructuringMode": {
      "enum": [
        "runtime",
        "host"
      ],
      "title": "StructuringMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "General v2 readiness payload shared by runtime clients.",
  "properties": {
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "service": {
      "const": "capture-runtime",
      "default": "capture-runtime",
      "title": "Service",
      "type": "string"
    },
    "apiVersion": {
      "const": "2.0",
      "default": "2.0",
      "title": "Apiversion",
      "type": "string"
    },
    "runtimeVersion": {
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Runtimeversion",
      "type": "string"
    },
    "captureDocumentSchemaVersion": {
      "const": "2",
      "default": "2",
      "title": "Capturedocumentschemaversion",
      "type": "string"
    },
    "captureDocumentSchemaSha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capturedocumentschemasha256"
    },
    "contractSetVersion": {
      "const": "2",
      "default": "2",
      "title": "Contractsetversion",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/RuntimeCapabilities"
    },
    "ocrCompute": {
      "anyOf": [
        {
          "$ref": "#/$defs/OcrComputePreflight"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    }
  },
  "required": [
    "ready",
    "capabilities",
    "runtimeVersion"
  ],
  "title": "RuntimeReady",
  "type": "object"
}
