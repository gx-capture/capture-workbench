      }
    },
    "cargo-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --manifest-path packages/capture-sidecar-launcher/Cargo.toml"
      }
    },
    "cargo-test": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path packages/capture-sidecar-launcher/Cargo.toml"
      }
    }
  }
}
