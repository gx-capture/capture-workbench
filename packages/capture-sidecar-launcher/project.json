{
  "name": "capture-sidecar-launcher",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/capture-sidecar-launcher/src",
  "projectType": "library",
  "tags": ["scope:capture", "type:sidecar-launcher", "platform:rust"],
  "targets": {
    "cargo-fmt-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "cargo fmt --manifest-path packages/capture-sidecar-launcher/Cargo.toml -- --check"
      }
    },
    "cargo-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --manifest-path packages/capture-sidecar-launcher/Cargo.toml"
      }
    },
    "cargo-test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/tools/cargo-test-retry-failed.ts",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/contracts/**/*",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/contract_set.py",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/_contract_set_bundle.py",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/constants/**/*",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/release.py",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/assets/contract-set.json",
        "{workspaceRoot}/packages/capture-runtime/src/capture_runtime/assets/contract-set.sha256",
        "{workspaceRoot}/packages/capture-runtime/tests/fixtures/speaker-wire-samples.json",
        "{workspaceRoot}/packages/capture-runtime/tests/fixtures/ocr-projection-v3-perspective.json",
        "{workspaceRoot}/packages/capture-runtime/tests/fixtures/ocr-page-selection-v3.json",
        "{workspaceRoot}/packages/capture-runtime/tests/fixtures/ocr-projection-v3-referenced-invalid-corpus.json"
      ],
      "options": {
        "command": "node tools/cargo-test-retry-failed.ts --manifest-path packages/capture-sidecar-launcher/Cargo.toml",
        "env": { "RUST_TEST_THREADS": "4" }
      }
    },
    "cargo-package-dry-run": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo package --manifest-path packages/capture-sidecar-launcher/Cargo.toml --allow-dirty"
      }
    },
    "cargo-publish-dry-run": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo publish --manifest-path packages/capture-sidecar-launcher/Cargo.toml --allow-dirty --dry-run"
      }
    }
  }
}
