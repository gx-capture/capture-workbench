{
  "name": "capture-sidecar-launcher",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/capture-sidecar-launcher/src",
  "projectType": "library",
  "tags": ["scope:capture", "type:sidecar-launcher", "platform:rust"],
  "targets": {
    "cargo-fmt-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
