{
  "name": "capture-sidecar-launcher",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/capture-sidecar-launcher/src",
  "projectType": "library",
  "tags": ["scope:capture", "type:sidecar-launcher", "platform:rust"],
  "targets": {
    "cargo-fmt-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --manifest-path packages/capture-sidecar-launcher/Cargo.toml -- --check"
      }
    },
    "cargo-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --manifest-path packages/capture-sidecar-launcher/Cargo.toml"
      }
    },
    "cargo-test": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["cargo-fixture-build"],
      "options": {
        "command": "cargo test --manifest-path packages/capture-sidecar-launcher/Cargo.toml",
        "env": { "RUST_TEST_THREADS": "4" }
      }
    },
    "cargo-fixture-build": {
      "cache": true,
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/tests/fixtures/activation-probe/target"
      ],
      "options": {
        "command": "cargo build --locked --manifest-path packages/capture-sidecar-launcher/tests/fixtures/activation-probe/Cargo.toml"
      }
    },
    "cargo-fixture-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --locked --manifest-path packages/capture-sidecar-launcher/tests/fixtures/activation-probe/Cargo.toml"
      }
    },
    "cargo-fixture-test": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["cargo-fixture-build"],
      "options": {
        "command": "cargo test --locked --manifest-path packages/capture-sidecar-launcher/tests/fixtures/activation-probe/Cargo.toml"
      }
    },
    "cargo-package-dry-run": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo package --manifest-path packages/capture-sidecar-launcher/Cargo.toml --allow-dirty"
      }
    },
    "cargo-publish-dry-run": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo publish --manifest-path packages/capture-sidecar-launcher/Cargo.toml --allow-dirty --dry-run"
      }
    }
  }
}
