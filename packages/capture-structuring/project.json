{
  "name": "capture-structuring",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/capture-structuring/src",
  "projectType": "library",
  "tags": ["npm:public", "scope:capture", "type:sdk"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p packages/capture-structuring/tsconfig.json"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": [
        {
          "target": "build",
        "projects": ["capture-runtime-client"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "main": "packages/capture-structuring/src/index.ts",
        "outputPath": "dist/packages/capture-structuring",
        "outputFileName": "index.js",
        "rootDir": "packages/capture-structuring/src",
        "tsConfig": "packages/capture-structuring/tsconfig.lib.json",
        "generatePackageJson": true,
        "generateExportsField": true,
        "assets": [
          {
            "glob": "README.md",
            "input": "packages/capture-structuring",
            "output": "."
          }
        ]
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "target": "pack",
          "projects": ["capture-runtime-client"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/packs"],
      "options": {
        "cwd": "dist/packages/capture-structuring",
        "commands": [
          "node ../../../tools/finalize-structuring-package.ts .",
          "corepack pnpm pack --pack-destination ../../packs"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config packages/capture-structuring/vitest.config.ts packages/capture-structuring/src/structuring.spec.ts"
      }
    }
  }
}
