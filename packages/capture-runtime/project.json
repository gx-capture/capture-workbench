{
  "name": "capture-runtime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "packages/capture-runtime",
  "sourceRoot": "packages/capture-runtime/src",
  "projectType": "application",
  "tags": ["scope:capture", "type:backend"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 capture-runtime serve"
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 ruff check src scripts tests && uv run --python 3.12 ruff format --check src scripts tests"
      }
    },
    "typecheck": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 mypy src && pnpm exec tsc -p tests/tsconfig.json"
      }
    },
    "test-unit": {
      "cache": true,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Hermetic unit and contract tests collected only from tests/unit."
      },
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/coverage/packages/capture-runtime"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 pytest tests/unit && node --test tests/unit/*.test.ts"
      }
    },
    "test-integration": {
      "cache": true,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Multi-component tests collected only from tests/integration; external downloads and packaged runtimes remain excluded."
      },
      "inputs": ["default"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 pytest tests/integration"
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["test-unit", "test-integration", "check-worker-stage-policy"],
      "metadata": {
        "description": "Compatibility aggregate for the separately collected unit and integration targets."
      },
      "inputs": ["default"],
      "options": {
        "command": "node -e \"process.stdout.write('capture-runtime unit and integration targets completed\\n')\""
      }
    },
    "e2e-local-package-pdf-ocr": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["build-release-artifacts"],
      "metadata": {
        "description": "Builds and launches the real local package, downloads its OCR worker from the dedicated exact loopback URL, and validates all-page PaddleOCR semantics."
      },
      "outputs": [
        "{workspaceRoot}/tmp/capture-runtime/pdf-ocr-e2e/local-package/evidence.json"
      ],
      "options": {
        "command": "node packages/capture-runtime/tests/e2e/local-package/pdf-ocr.e2e.ts"
      }
    },
    "e2e-online-package-pdf-ocr": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Downloads the official online runtime package, forbids local worker URL overrides, installs the catalog HTTPS OCR worker, and validates all-page PaddleOCR semantics."
      },
      "outputs": [
        "{workspaceRoot}/tmp/capture-runtime/pdf-ocr-e2e/online-package/evidence.json"
      ],
      "options": {
        "command": "node packages/capture-runtime/tests/e2e/online-package/pdf-ocr.e2e.ts"
      }
    },
    "build": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv build"
      }
    },
    "generate-schema": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/schema"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/generate_schema.py --output dist/schema/capture-document-v2.schema.json"
      }
    },
    "generate-production-schema": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/schema"],
      "metadata": {
        "description": "Generates the release schema without mutating the verified production environment."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/generate_schema.py --output dist/schema/capture-document-v2.schema.json"
      }
    },
    "generate-contracts": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": [
        "{projectRoot}/src/capture_runtime/assets/contract-set.json",
        "{projectRoot}/src/capture_runtime/assets/contract-set.sha256",
        "{projectRoot}/src/capture_runtime/assets/ocr-profile.json",
        "{workspaceRoot}/packages/capture-runtime-client-java/src/main/java/com/gx/capture/runtime/client/CaptureRuntimeTypes.java",
        "{workspaceRoot}/packages/capture-runtime-client-java/src/main/resources/capture-runtime-contract-set.sha256",
        "{workspaceRoot}/packages/capture-runtime-client/src/private/generated-contracts.ts",
        "{workspaceRoot}/packages/capture-runtime-client/src/private/capture-document-schema.ts",
        "{workspaceRoot}/packages/capture-runtime-client/src/private/assets/contract-set.json",
        "{workspaceRoot}/packages/capture-runtime-client/src/private/assets/contract-set.sha256",
        "{workspaceRoot}/packages/capture-runtime-client-python/src/capture_runtime_client/private/generated_models.py",
        "{workspaceRoot}/packages/capture-runtime-client-python/src/capture_runtime_client/private/schemas",
        "{workspaceRoot}/packages/capture-runtime-client-python/src/capture_runtime_client/private/assets/contract-set.json",
        "{workspaceRoot}/packages/capture-runtime-client-python/src/capture_runtime_client/private/assets/contract-set.sha256"
      ],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/generate_contracts.py"
      }
    },
    "check-contracts": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "{projectRoot}/src/capture_runtime/assets/contract-set.json",
        "{projectRoot}/src/capture_runtime/assets/contract-set.sha256",
        "{projectRoot}/src/capture_runtime/assets/ocr-profile.json",
        "{workspaceRoot}/packages/capture-runtime-client-java/src/main/java/com/gx/capture/runtime/client/CaptureRuntimeTypes.java",
        "{workspaceRoot}/packages/capture-runtime-client-java/src/main/resources/capture-runtime-contract-set.sha256",
        "{workspaceRoot}/packages/capture-runtime-client/src/private/generated-contracts.ts",
        "{workspaceRoot}/packages/capture-runtime-client/src/private/capture-document-schema.ts",
        "{workspaceRoot}/packages/capture-runtime-client/src/private/assets/contract-set.json",
        "{workspaceRoot}/packages/capture-runtime-client/src/private/assets/contract-set.sha256",
        "{workspaceRoot}/packages/capture-runtime-client-python/src/capture_runtime_client/private/generated_models.py",
        "{workspaceRoot}/packages/capture-runtime-client-python/src/capture_runtime_client/private/schemas",
        "{workspaceRoot}/packages/capture-runtime-client-python/src/capture_runtime_client/private/assets/contract-set.json",
        "{workspaceRoot}/packages/capture-runtime-client-python/src/capture_runtime_client/private/assets/contract-set.sha256"
      ],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/generate_contracts.py --check"
      }
    },
    "generate-worker-stage-policy": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/scripts/generate_worker_stage_policy.py",
        "{projectRoot}/src/capture_runtime/assets/worker-stage-policy.json"
      ],
      "outputs": [
        "{projectRoot}/src/capture_runtime/_generated_worker_stage_policy.py",
        "{workspaceRoot}/tools/generated-worker-stage-policy.ts"
      ],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/generate_worker_stage_policy.py"
      }
    },
    "check-worker-stage-policy": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/scripts/generate_worker_stage_policy.py",
        "{projectRoot}/src/capture_runtime/assets/worker-stage-policy.json",
        "{projectRoot}/src/capture_runtime/_generated_worker_stage_policy.py",
        "{workspaceRoot}/tools/generated-worker-stage-policy.ts"
      ],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/generate_worker_stage_policy.py --check"
      }
    },
    "build-executable": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/executable"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/build_executable.py --layout onefile --catalog src/capture_runtime/assets/engine-catalog.json"
      }
    },
    "build-core-executable": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": [
        "{projectRoot}/dist/executable",
        "{projectRoot}/dist/core-onefile"
      ],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/build_executable.py --layout onefile --catalog src/capture_runtime/assets/engine-catalog.json"
      }
    },
    "build-core-onedir": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/core-onedir"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/build_executable.py --layout onedir --catalog src/capture_runtime/assets/engine-catalog.json"
      }
    },
    "prepare-production-environment": {
      "cache": false,
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Synchronizes optional worker dependencies and repairs overlapping ONNX Runtime namespace transitions."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv sync --python 3.12 --extra windowsml --extra whisper --reinstall-package onnxruntime-directml"
      }
    },
    "verify-production-environment": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["prepare-production-environment"],
      "metadata": {
        "description": "Requires DirectML to be the sole ONNX Runtime distribution and provider for Windows production builds."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/verify_production_environment.py"
      }
    },
    "build-production-executable": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["generate-release-engine-catalog"],
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/executable"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/build_executable.py --layout onefile --catalog dist/catalog/capture-engine-catalog.json"
      }
    },
    "build-ocr-worker": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["verify-production-environment"],
      "inputs": ["production"],
      "outputs": [
        "{projectRoot}/dist/engines/capture-engine-ocr-*.zip",
        "{projectRoot}/dist/engines/capture-engine-ocr-*-files.json"
      ],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/build_ocr_worker.py"
      }
    },
    "build-whisper-worker": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["verify-production-environment"],
      "inputs": ["production"],
      "outputs": [
        "{projectRoot}/dist/engines/capture-engine-whisper-*.zip",
        "{projectRoot}/dist/engines/capture-engine-whisper-*-files.json"
      ],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/build_whisper_worker.py"
      }
    },
    "validate-model-source-lock": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "metadata": {
        "description": "Validates the canonical core-only or approved model-enabled release source lock."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/model_source_lock.py validate"
      }
    },
    "validate-commit-a-fixtures": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "metadata": {
        "description": "Verifies reproducible project-owned Commit A OCR fixtures and provenance."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/generate_commit_a_fixtures.py --check"
      }
    },
    "classify-release-model-mode": {
      "cache": false,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/metadata/release-model-mode.json"],
      "metadata": {
        "description": "Writes the fail-closed release mode derived from the canonical checked-in source lock."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/model_source_lock.py classify --output dist/metadata/release-model-mode.json"
      }
    },
    "generate-engine-catalog": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["build-ocr-worker", "build-whisper-worker"],
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/catalog/capture-engine-catalog.json"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/generate_engine_catalog.py --output dist/catalog/capture-engine-catalog.json --ocr-worker-archive dist/engines/capture-engine-ocr-0.4.2-windows-x64.zip --ocr-worker-manifest dist/engines/capture-engine-ocr-0.4.2-windows-x64-files.json --whisper-worker-archive dist/engines/capture-engine-whisper-0.4.2-windows-x64.zip --whisper-worker-manifest dist/engines/capture-engine-whisper-0.4.2-windows-x64-files.json"
      }
    },
    "generate-release-engine-catalog": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-ocr-worker",
        "build-whisper-worker",
        "validate-model-source-lock"
      ],
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/catalog/capture-engine-catalog.json"],
      "metadata": {
        "description": "Generates an empty core-only catalog or a fully approved model-enabled publication catalog."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/generate_engine_catalog.py --model-source-lock model-sources/release-model-source-lock.json --output dist/catalog/capture-engine-catalog.json --ocr-worker-archive dist/engines/capture-engine-ocr-0.4.2-windows-x64.zip --ocr-worker-manifest dist/engines/capture-engine-ocr-0.4.2-windows-x64-files.json --whisper-worker-archive dist/engines/capture-engine-whisper-0.4.2-windows-x64.zip --whisper-worker-manifest dist/engines/capture-engine-whisper-0.4.2-windows-x64-files.json"
      }
    },
    "verify-release-model-candidate": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["generate-release-engine-catalog"],
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/candidate/model-probe-evidence.json"],
      "metadata": {
        "description": "Opt-in local release gate that performs checksum-pinned direct model downloads and real OCR/Whisper worker runs."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/verify_release_model_candidate.py"
      }
    },
    "generate-whisper-preflight-catalog": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["build-ocr-worker", "build-whisper-worker"],
      "inputs": ["production"],
      "outputs": [
        "{projectRoot}/dist/catalog/preflight-capture-engine-catalog.json"
      ],
      "metadata": {
        "description": "Generates a complete source-lock-bound catalog only for the blocked private Whisper preflight lock."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/generate_engine_catalog.py --allow-pending-preflight --model-source-lock model-sources/release-model-source-lock.json --output dist/catalog/preflight-capture-engine-catalog.json --ocr-worker-archive dist/engines/capture-engine-ocr-0.4.2-windows-x64.zip --ocr-worker-manifest dist/engines/capture-engine-ocr-0.4.2-windows-x64-files.json --whisper-worker-archive dist/engines/capture-engine-whisper-0.4.2-windows-x64.zip --whisper-worker-manifest dist/engines/capture-engine-whisper-0.4.2-windows-x64-files.json"
      }
    },
    "verify-whisper-preflight": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["generate-whisper-preflight-catalog"],
      "outputs": [
        "{projectRoot}/dist/candidate/whisper-preflight-evidence.json"
      ],
      "metadata": {
        "description": "Runs one privacy-safe private Whisper preflight; output never includes audio paths or text."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/verify_release_model_candidate.py --preflight-whisper --catalog dist/catalog/preflight-capture-engine-catalog.json --output dist/candidate/whisper-preflight-evidence.json"
      }
    },
    "verify-core-boundary": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["build-core-executable"],
      "outputs": [
        "{projectRoot}/dist/core-inventory.txt",
        "{projectRoot}/dist/core-inventory-recursive.txt"
      ],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/verify_boundaries.py --core dist/executable/capture-runtime.exe --core-inventory dist/core-inventory.txt --core-recursive-inventory dist/core-inventory-recursive.txt"
      }
    },
    "verify-production-core-boundary": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["build-production-executable"],
      "outputs": [
        "{projectRoot}/dist/production-core-inventory.txt",
        "{projectRoot}/dist/production-core-inventory-recursive.txt"
      ],
      "metadata": {
        "description": "Requires the production core artifact to contain the packaged PyAV decoder and FFmpeg libraries."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/verify_boundaries.py --core dist/executable/capture-runtime.exe --core-inventory dist/production-core-inventory.txt --core-recursive-inventory dist/production-core-inventory-recursive.txt"
      }
    },
    "verify-worker-boundaries": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["build-ocr-worker", "build-whisper-worker"],
      "outputs": [
        "{projectRoot}/dist/ocr-worker-inventory.txt",
        "{projectRoot}/dist/whisper-worker-inventory.txt"
      ],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/verify_boundaries.py --ocr-worker dist/engines/capture-engine-ocr-0.4.2-windows-x64.zip --ocr-inventory dist/ocr-worker-inventory.txt --whisper-worker dist/engines/capture-engine-whisper-0.4.2-windows-x64.zip --whisper-inventory dist/whisper-worker-inventory.txt"
      }
    },
    "bundle-size-report": {
      "cache": false,
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/size/runtime-size-report.json"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/report_bundle_size.py --executable dist/release/capture-runtime-x86_64-pc-windows-msvc.exe --installer \"../../apps/capture-workbench-desktop/src-tauri/target/x86_64-pc-windows-msvc/release/bundle/nsis/Capture Workbench_0.4.2_x64-setup.exe\" --installed-size-evidence ../../tmp/capture-workbench-desktop/installed-smoke/installed-size.json --pyinstaller-work .build/pyinstaller/core-onefile --output dist/size/runtime-size-report.json"
      }
    },
    "size-regression-check": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["bundle-size-report"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/size_regression_check.py --report dist/size/runtime-size-report.json --budgets size-budgets/windows-x64.json"
      }
    },
    "size-regression-check-model-enabled": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["bundle-size-report"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/size_regression_check.py --report dist/size/runtime-size-report.json --budgets size-budgets/windows-x64-model-enabled.json"
      }
    },
    "build-release-artifacts": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-production-executable",
        "generate-production-schema",
        "verify-worker-boundaries",
        "verify-production-core-boundary"
      ],
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/release"],
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --no-sync --python 3.12 python scripts/build_release_artifacts.py"
      }
    },
    "build-core-release-artifacts": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["build-core-executable", "generate-schema"],
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/core-release"],
      "metadata": {
        "description": "Builds the core-only runtime artifact set permitted in the initial NSIS package."
      },
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python scripts/build_core_release_artifacts.py"
      }
    },
    "local-release-consumer-smoke": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/local-release-consumer-smoke.ts"
      }
    },
    "python-version-check": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/capture-runtime",
        "command": "uv run --python 3.12 python -c \"import sys; assert sys.version_info[:2] == (3, 12)\""
      }
    }
  }
}
